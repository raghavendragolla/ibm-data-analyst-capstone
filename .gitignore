# Project data (regenerable via src/data_collection.py, src/data_cleaning.py,
# and src/build_database.py -- see data/README.md for the reproduction policy).
# Kept out of git so clones stay small; visualizations/ (portfolio output) is
# small enough to keep committed and is NOT excluded here.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Whitelist processed database for Streamlit Community Cloud deployment
!data/processed/capstone.db
